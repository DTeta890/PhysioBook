# Development Dockerfile — uses dotnet watch for hot reload
FROM mcr.microsoft.com/dotnet/sdk:8.0

WORKDIR /src/backend

# Copy project files for restore
COPY src/backend/PhysioBook.sln .
COPY src/backend/src/PhysioBook.Api/PhysioBook.Api.csproj src/PhysioBook.Api/
COPY src/backend/src/PhysioBook.Application/PhysioBook.Application.csproj src/PhysioBook.Application/
COPY src/backend/src/PhysioBook.Domain/PhysioBook.Domain.csproj src/PhysioBook.Domain/
COPY src/backend/src/PhysioBook.Infrastructure/PhysioBook.Infrastructure.csproj src/PhysioBook.Infrastructure/
COPY src/backend/tests/PhysioBook.UnitTests/PhysioBook.UnitTests.csproj tests/PhysioBook.UnitTests/
COPY src/backend/tests/PhysioBook.IntegrationTests/PhysioBook.IntegrationTests.csproj tests/PhysioBook.IntegrationTests/

RUN dotnet restore

# Copy remaining source
COPY src/backend/ .

EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000

# Use dotnet watch for hot reload in development
ENTRYPOINT ["dotnet", "watch", "run", "--project", "src/PhysioBook.Api/PhysioBook.Api.csproj", "--no-launch-profile"]

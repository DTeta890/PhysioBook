# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy solution and project files for restore
COPY src/backend/PhysioBook.sln .
COPY src/backend/src/PhysioBook.Api/PhysioBook.Api.csproj src/PhysioBook.Api/
COPY src/backend/src/PhysioBook.Application/PhysioBook.Application.csproj src/PhysioBook.Application/
COPY src/backend/src/PhysioBook.Domain/PhysioBook.Domain.csproj src/PhysioBook.Domain/
COPY src/backend/src/PhysioBook.Infrastructure/PhysioBook.Infrastructure.csproj src/PhysioBook.Infrastructure/

RUN dotnet restore

# Copy remaining source and publish
COPY src/backend/src/ .
RUN dotnet publish src/PhysioBook.Api/PhysioBook.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 --ingroup appgroup appuser

COPY --from=build /app/publish .

USER appuser

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "PhysioBook.Api.dll"]
